# Copy this file to `.env` (or export these as real environment variables).
# Nothing here is required to run the app — every value below is optional
# and has a sensible default. Siara (the guide bot) needs NO API key and NO
# signup: she uses the same free, local LLM the main pipeline already loads
# (see backend/assistant.py) — not any paid API.

# Optional: cap how many CPU threads the backend's AI models use. Default is
# half your CPU cores (min 1, max 4) if unset. Lower this if the machine
# running the backend overheats or becomes unresponsive during a request;
# raise it on a beefier machine for faster responses.
BASEERA_CPU_THREADS=

# Optional: the local LLM used for object extraction + reply phrasing, AND
# for Siara's conversational answers (they share this one model). Default
# is Qwen2.5-0.5B-Instruct — changed from 1.5B-Instruct after a real
# MemoryError crash while loading weights on a RAM-constrained machine. If
# you have RAM to spare and want better answers (both Baseera's and
# Siara's), you can go back up:
#   BASEERA_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
BASEERA_LLM_MODEL=

# Optional: Whisper model size for speech-to-text. Default is "base".
# Use "tiny" for an even lighter/faster (but less accurate) option on very
# constrained machines.
BASEERA_WHISPER_MODEL=

# Optional: set to "off" to make Siara skip the local LLM entirely and
# always use instant rule-based answers instead — for keeping her as light
# as possible on a very constrained machine, at the cost of only answering
# a fixed set of keyword-matched questions rather than free conversation.
BASEERA_SIARA_LLM=on

# Optional: where the frontend should look for the backend, if not localhost.
BACKEND_URL=http://127.0.0.1:8000
