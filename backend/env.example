# Copy this file to `.env` (or export these as real environment variables)
# and fill in your own key. None of this is required to run the core
# Baseera pipeline — it only upgrades Siara (the guide bot) from
# rule-based answers to full conversational LLM answers.

# Preferred: free, no credit card. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model Siara uses via Groq. Defaults to a small,
# fast model since this is a lightweight Q&A widget, not the main pipeline.
GROQ_MODEL=llama-3.1-8b-instant

# Optional alternative to Groq (paid). Only used if GROQ_API_KEY is unset,
# or Groq's call fails. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: cap how many CPU threads the backend's AI models use. Default is
# half your CPU cores (min 1, max 4) if unset. Lower this if the machine
# running the backend overheats or becomes unresponsive during a request;
# raise it on a beefier machine for faster responses.
BASEERA_CPU_THREADS=

# Optional: where the frontend should look for the backend, if not localhost.
BACKEND_URL=http://127.0.0.1:8000
