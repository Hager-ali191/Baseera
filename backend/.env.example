# Copy this file to `.env` (or export these as real environment variables)
# and fill in your own key. None of this is required to run the core
# Baseera pipeline — it only upgrades Siara (the guide bot) from
# rule-based answers to full conversational LLM answers.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model Siara uses. Defaults to a small, fast, cheap
# model since this is a lightweight Q&A widget, not the main pipeline.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: where the frontend should look for the backend, if not localhost.
BACKEND_URL=http://127.0.0.1:8000
