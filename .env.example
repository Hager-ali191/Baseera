# Read automatically by `docker compose` from the project root.
# Copy this file to `.env` and fill in your key to give Siara full LLM mode.
# Leave blank to run Siara in rule-based fallback mode — still works, just
# less flexible about phrasing.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: caps CPU threads used by the backend's AI models. Lower this
# (e.g. 2) if your machine overheats or becomes unresponsive while a
# request is running. Defaults to half the visible CPU cores if unset.
BASEERA_CPU_THREADS=
